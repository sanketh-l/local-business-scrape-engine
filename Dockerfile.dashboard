FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LEADGEN_DB_PATH=/app/data/leadgen.sqlite \
    LEADGEN_RAW_DIR=/app/data/raw \
    LEADGEN_EXPORT_DIR=/app/data/exports

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY configs ./configs

RUN pip install --no-cache-dir -e .
RUN mkdir -p /app/data/raw /app/data/exports

EXPOSE 8501

CMD ["streamlit", "run", "src/leadgen/dashboard.py", "--server.address=0.0.0.0", "--server.port=8501"]
